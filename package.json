{
  "name": "tecnobloques",
  "version": "0.4.0",
  "private": true,
  "description": "Editor de bloques en español para programar Arduino Uno, Nano y Mega con las librerías de la TecnoAcademia Tolima (SENA).",
  "main": "escritorio/main.js",
  "scripts": {
    "build": "node build.js",
    "test": "python test/prueba.py && python test/prueba_todo.py",
    "test:ui": "python test/ui.py",
    "compilar": "node test/compilar.js",
    "app": "node build.js && electron .",
    "app:simulador": "node build.js --simulador-local && electron .",
    "build:simulador": "node build.js --simulador-local",
    "preparar-arduino": "node escritorio/preparar-arduino.js",
    "instalador": "node build.js && node escritorio/empaquetar.js",
    "publicar": "node build.js && node escritorio/empaquetar.js --publicar",
    "test:app": "node test/app.js",
    "test:placas": "node test/placas.js",
    "test:graficador": "node test/graficador.js",
    "test:registro": "node test/registro.js",
    "test:registro-preprocesador": "node test/registro-preprocesador.js",
    "test:registro-app": "node build.js --simulador-local && node test/registro-app.js",
    "test:proyectos": "node build.js --simulador-local && node test/proyectos-app.js",
    "test:herramientas": "node build.js && node test/herramientas-app.js",
    "test:historia": "node test/historia-registro.js",
    "historia": "node herramientas/historia-registro.js",
    "test:simulador": "node build.js --simulador-local && node test/simulador.js"
  },
  "devDependencies": {
    "blockly": "13.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "tecnocircuito": "github:EMariotte/TecnoCircuito#v0.2.0"
  },
  "license": "Apache-2.0",
  "author": "Efraín Guillermo Mariotte Parra — TecnoAcademia Tolima (SENA)",
  "build": {
    "appId": "co.edu.sena.tecnoacademia.tecnobloques",
    "productName": "TecnoBloques",
    "copyright": "© 2026 SENA – TecnoAcademia Tolima",
    "directories": {
      "output": "release"
    },
    "files": [
      "escritorio/main.js",
      "escritorio/preload.js",
      "escritorio/arduino.js",
      "escritorio/registro-disco.js",
      "src/registro.js",
      "escritorio/icono.png",
      "dist/TecnoBloques.html",
      "package.json",
      "LICENSE",
      "NOTICE",
      "escritorio/icono.ico"
    ],
    "extraResources": [
      {
        "from": "escritorio/recursos/arduino",
        "to": "arduino"
      },
      {
        "from": "escritorio/recursos/drivers",
        "to": "drivers",
        "filter": [
          "*.EXE",
          "*.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "escritorio/icono.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "TecnoBloques",
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "include": "escritorio/instalador.nsh",
      "artifactName": "TecnoBloques-Setup-${version}.${ext}",
      "installerIcon": "escritorio/icono.ico",
      "uninstallerIcon": "escritorio/icono.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EMariotte",
        "repo": "TecnoBloques"
      }
    ]
  }
}
